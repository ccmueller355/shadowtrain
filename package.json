{
  "name": "shadowtrain",
  "version": "0.1.1",
  "main": "index.ts",
  "private": true,
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.20.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.23",
    "expo": "~58.0.22",
    "expo-dev-client": "~58.0.20",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "mermaid": "^12.0.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-paper": "^5.13.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-toast-message": "^2.5.2",
    "react-native-worklets": "0.13.0",
    "typescript": "~7.0.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.44",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.3.0",
    "test-renderer": "^1.3.1",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "jest",
    "test:ct": "jest --testPathPatterns=ct\\.test",
    "test:coverage": "jest --coverage",
    "lint": "eslint src app scripts App.tsx index.ts",
    "lint:fix": "eslint --fix src app scripts App.tsx index.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\" \"app/**/*.{ts,tsx}\" \"scripts/**/*.ts\" App.tsx index.ts \"docs/**/*.md\" README.md CHANGELOG.md",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\" \"app/**/*.{ts,tsx}\" \"scripts/**/*.ts\" App.tsx index.ts \"docs/**/*.md\" README.md CHANGELOG.md",
    "docs:build:full": "npm run test:coverage && rm -rf docs/public/coverage && mkdir -p docs/public/coverage && cp -r coverage/lcov-report/* docs/public/coverage/ && vitepress build docs",
    "typecheck": "tsc --noEmit",
    "doctor": "npx --yes expo-doctor",
    "ci": "bash scripts/ci-local.sh",
    "ci:quick": "bash scripts/ci-local.sh --quick",
    "hooks:install": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit scripts/ci-local.sh",
    "prepare": "git config core.hooksPath .githooks || true",
    "sync-version": "node -e \"const fs=require('fs'); const v=fs.readFileSync('VERSION','utf8').trim(); const a=JSON.parse(fs.readFileSync('app.json','utf8')); a.expo.version=v; fs.writeFileSync('app.json',JSON.stringify(a,null,2)+'\\n'); const p=JSON.parse(fs.readFileSync('package.json','utf8')); p.version=v; fs.writeFileSync('package.json',JSON.stringify(p,null,2)+'\\n'); const r=fs.readFileSync('README.md','utf8').replace(/badge\\/version-[0-9A-Za-z.-]+-blue/,'badge/version-'+v+'-blue'); fs.writeFileSync('README.md',r); console.log('Synced version → '+v);\""
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|react-native-gesture-handler|react-native-reanimated|react-native-screens|react-native-safe-area-context|react-native-toast-message|react-native-paper|react-native-vector-icons|react-native-worklets|zustand)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "app/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "react-native-safe-area-context",
        "expo",
        "expo-sharing",
        "expo-splash-screen",
        "jest-expo",
        "jest",
        "@types/jest",
        "eslint",
        "prettier"
      ]
    }
  }
}
